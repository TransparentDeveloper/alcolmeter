---
interface Link {
  slug: string;
  text: string;
}

interface Props {
  items: readonly (Link & { children: readonly Link[] })[];
}

const { items } = Astro.props;
const MIN_ITEMS = 3;
---

{
  items.length >= MIN_ITEMS && (
    <nav class="toc" aria-labelledby="toc-label">
      <p id="toc-label" class="label">목차</p>
      <ol class="list">
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`}>{item.text}</a>
            {item.children.length > 0 && (
              <ol class="sub-list">
                {item.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    margin-bottom: var(--am-dimension-x10);
    padding-block: var(--am-dimension-x4) var(--am-dimension-x2);
    border-block: 1px solid var(--am-color-stroke-neutral-subtle);
  }

  .label {
    font: var(--am-text-style-meta);
    color: var(--am-color-fg-neutral-subtle);
  }

  .list {
    padding-inline-start: var(--am-dimension-x6);
  }

  .list a {
    display: block;
    padding-block: var(--am-dimension-x2);
    font: var(--am-text-style-article-body);
    color: var(--am-color-fg-neutral);
  }

  .list .sub-list {
    padding-inline-start: var(--am-dimension-x4);
    list-style: none;
  }

  .list .sub-list a {
    padding-block: var(--am-dimension-x1);
    font: var(--am-text-style-meta);
    color: var(--am-color-fg-neutral-subtle);
  }

  .list a:hover {
    text-decoration: underline 2px;
    text-underline-offset: 3px;
  }

  /* lg 에서는 상세 페이지 격자의 왼쪽 열에 놓인다. 열 배치는 페이지가 정한다(D-041). */
  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: var(--am-dimension-x6);
      max-height: calc(100dvh - 2 * var(--am-dimension-x6));
      overflow-y: auto;
      margin-bottom: 0;
      padding: 0 var(--am-dimension-x1) var(--am-dimension-x1) 0;
      scroll-padding-block: var(--am-dimension-x1);
      border-block: none;
    }

    .list > li > a {
      font: var(--am-text-style-article-note);
      color: var(--am-color-fg-neutral-muted);
    }
  }
</style>
