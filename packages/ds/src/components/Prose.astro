<div class="am-prose">
  <slot />
</div>

<style is:global>
  /* 마크다운이 만든 요소는 scoped 스타일이 닿지 않아 .am-prose 아래 전역 스타일로 둔다. */
  .am-prose {
    font: var(--am-text-style-article-body);
    color: var(--am-color-fg-neutral);
  }

  .am-prose > * + * {
    margin-top: var(--am-dimension-paragraph-gap);
  }

  .am-prose > * + figure,
  .am-prose > figure + * {
    margin-top: var(--am-dimension-figure-gap);
  }

  .am-prose > h2 + * {
    margin-top: var(--am-dimension-heading-2-gap-bottom);
  }

  .am-prose > h3 + * {
    margin-top: var(--am-dimension-heading-3-gap-bottom);
  }

  /* 제목 간격이 그림 간격을, 제목 위 간격이 앞 제목의 아래 간격을 이기도록 이 순서를 지킨다. */
  /* 첫 요소인 h2 는 목차 아래 선과 겹치므로 구획 선을 * + h2 에만 둔다. */
  .am-prose > * + h2 {
    margin-top: var(--am-dimension-heading-2-gap-top);
    padding-top: var(--am-dimension-heading-2-gap-rule);
    border-top: 1px solid var(--am-color-stroke-neutral-subtle);
  }

  .am-prose > * + h3 {
    margin-top: var(--am-dimension-heading-3-gap-top);
  }

  .am-prose h2 {
    font: var(--am-text-style-article-heading-2);
  }

  .am-prose h3 {
    font: var(--am-text-style-article-heading-3);
  }

  .am-prose ul,
  .am-prose ol {
    padding-inline-start: var(--am-dimension-x6);
  }

  .am-prose a {
    color: var(--am-color-fg-brand);
    text-decoration: underline 1px;
    text-underline-offset: 3px;
  }

  .am-prose a:hover {
    text-decoration-thickness: 2px;
  }

  .am-prose strong {
    font-weight: var(--am-font-weight-medium);
  }

  .am-prose img {
    width: 100%;
    border-radius: var(--am-radius-r3);
    background: var(--am-color-bg-neutral-weak);
  }

  .am-prose blockquote {
    padding-inline-start: var(--am-dimension-x5);
    border-inline-start: 3px solid var(--am-color-stroke-neutral-subtle);
  }

  .am-prose table {
    width: 100%;
    border-collapse: collapse;
    font: var(--am-text-style-article-note);
    color: var(--am-color-fg-neutral-muted);
  }

  .am-prose th,
  .am-prose td {
    padding: var(--am-dimension-x2) var(--am-dimension-x3);
    border-block: 1px solid var(--am-color-stroke-neutral-subtle);
    font-weight: inherit;
    text-align: start;
    overflow-wrap: break-word;
  }

  /* 숫자 열은 마크다운 열 정렬(---:)로 표시한다. 처리기가 정렬을 인라인 style 로만 내보내 속성으로 고른다. */
  .am-prose :is(th, td)[style*='right'] {
    white-space: nowrap;
  }

  .am-prose thead th {
    background: var(--am-color-bg-neutral-weak);
  }
</style>
