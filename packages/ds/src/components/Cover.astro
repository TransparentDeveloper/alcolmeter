---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { contentImage } from '../lib/image';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<Image class="cover" src={image} alt={alt} widths={contentImage.widths} sizes={contentImage.sizes} priority />

<style>
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--am-radius-r3);
    background: var(--am-color-bg-neutral-weak);
    margin-bottom: var(--am-dimension-x10);
  }
</style>
