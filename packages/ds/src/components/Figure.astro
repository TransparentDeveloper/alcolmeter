---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { contentImage } from '../lib/image';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  variant?: 'content' | 'square';
}

const { src, alt, caption, variant = 'content' } = Astro.props;
---

<figure class:list={['figure', variant]}>
  <Image
    class="image"
    src={src}
    alt={alt}
    widths={contentImage.widths}
    sizes={contentImage.sizes}
    loading="lazy"
  />
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--am-radius-r3);
    background: var(--am-color-bg-neutral-weak);
  }

  .square .image {
    aspect-ratio: 1;
  }

  .caption {
    margin-top: var(--am-dimension-caption-gap);
    font: var(--am-text-style-article-note);
    color: var(--am-color-fg-neutral-muted);
  }
</style>
