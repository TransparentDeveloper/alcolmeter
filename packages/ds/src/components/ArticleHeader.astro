---
import { formatDate } from '../lib/date';

interface Props {
  title: string;
  publishedAt: Date;
  updatedAt?: Date;
}

const { title, publishedAt, updatedAt } = Astro.props;
---

<header class="article-header">
  <h1 class="title">{title}</h1>
  <p class="meta">
    작성 <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    {
      updatedAt && (
        <>
          {' · 수정 '}
          <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
        </>
      )
    }
  </p>
</header>

<style>
  .article-header {
    margin-bottom: var(--am-dimension-x10);
  }

  .title {
    font: var(--am-text-style-article-title);
    color: var(--am-color-fg-neutral);
  }

  .meta {
    margin-top: var(--am-dimension-x4);
    font: var(--am-text-style-meta);
    color: var(--am-color-fg-neutral-subtle);
  }
</style>
