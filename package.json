{
	"name": "alcolmeter",
	"version": "0.2.4",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"dev": "pnpm --filter @alcolmeter/web dev",
		"build": "pnpm --filter @alcolmeter/web build",
		"preview": "pnpm --filter @alcolmeter/web preview",
		"check": "pnpm --filter @alcolmeter/web check",
		"test:domain": "pnpm --filter @alcolmeter/domain test",
		"dev:extension": "pnpm --filter @alcolmeter/extension dev",
		"build:extension": "pnpm --filter @alcolmeter/extension build"
	}
}
