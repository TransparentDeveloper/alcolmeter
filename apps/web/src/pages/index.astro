---
import PostCard from '@alcolmeter/ds/components/PostCard.astro';
import PostGrid from '@alcolmeter/ds/components/PostGrid.astro';
import Base from '../layouts/Base.astro';
import { getPublishedPosts } from '../lib/posts';

const [featured, ...rest] = await getPublishedPosts();
---

<Base title="alcolmeter" description="술이 만들어지는 과정과 주류 정보를 정리해요.">
  <h1 class="visually-hidden">alcolmeter</h1>
  <div class="post-list am-width-page">
    {
      featured && (
        <PostCard
          variant="feature"
          href={`/posts/${featured.id}`}
          title={featured.data.title}
          summary={featured.data.description}
          image={featured.data.cover}
          imageAlt={featured.data.coverAlt}
          publishedAt={featured.data.publishedAt}
          updatedAt={featured.data.updatedAt}
          priority
        />
      )
    }
    {
      rest.length > 0 && (
        <PostGrid>
          {rest.map((post) => (
            <li>
              <PostCard
                href={`/posts/${post.id}`}
                title={post.data.title}
                summary={post.data.description}
                image={post.data.cover}
                imageAlt={post.data.coverAlt}
                publishedAt={post.data.publishedAt}
                updatedAt={post.data.updatedAt}
              />
            </li>
          ))}
        </PostGrid>
      )
    }
  </div>
</Base>

<style>
  .post-list > :global(* + *) {
    margin-top: var(--am-dimension-card-gap-y);
  }
</style>
