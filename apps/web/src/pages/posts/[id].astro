---
import ArticleHeader from '@alcolmeter/ds/components/ArticleHeader.astro';
import Callout from '@alcolmeter/ds/components/Callout.astro';
import Cover from '@alcolmeter/ds/components/Cover.astro';
import Figure from '@alcolmeter/ds/components/Figure.astro';
import Prose from '@alcolmeter/ds/components/Prose.astro';
import ProseTable from '@alcolmeter/ds/components/ProseTable.astro';
import TableOfContents from '@alcolmeter/ds/components/TableOfContents.astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, getTocItems } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const og = await getImage({
  src: post.data.cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  image: new URL(og.src, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={post.data.title} description={post.data.description} image={og.src} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <ArticleHeader
      title={post.data.title}
      summary={post.data.description}
      publishedAt={post.data.publishedAt}
      updatedAt={post.data.updatedAt}
    />
    <Cover image={post.data.cover} alt={post.data.coverAlt} />
    <TableOfContents items={getTocItems(headings)} />
    <Prose>
      <Content components={{ Figure, Callout, table: ProseTable }} />
    </Prose>
  </article>
</Base>
